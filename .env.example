# Copy to .env and adjust. .env is gitignored — never commit real values.

# Host port the Juice Shop SUT is published on (docker-compose reads this too).
JUICE_SHOP_PORT=3000

# Base URL the tests target. Must match JUICE_SHOP_PORT above.
BASE_URL=http://localhost:3000

# Password used for factory-generated test users.
TEST_USER_PASSWORD=
